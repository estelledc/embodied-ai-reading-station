{
  "name": "embodied-ai-reading-station",
  "version": "1.2.0",
  "description": "Embodied AI paper reading station — atelier-zero editorial style",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && pagefind --site dist --output-subdir pagefind",
    "check": "node scripts/check.mjs",
    "provenance:generate": "node scripts/generate-provenance.mjs",
    "test:unit": "node --test 'scripts/**/*.test.mjs'",
    "test": "npm run test:unit && npm run build && npm run check",
    "serve": "python3 -m http.server -d dist 8080",
    "serve:csp": "node scripts/serve-csp.mjs"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^14.1.3",
    "pagefind": "^1.5.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "d3": "^7.9.0",
    "katex": "^0.17.0"
  }
}
