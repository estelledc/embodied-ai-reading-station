{
  "name": "embodied-ai-reading-station",
  "version": "1.0.0",
  "description": "Embodied AI paper reading station — atelier-zero editorial style",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && pagefind --site dist --output-subdir pagefind",
    "check": "node scripts/check.mjs",
    "test": "npm run build && npm run check",
    "serve": "python3 -m http.server -d dist 8080"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^14.1.3",
    "pagefind": "^1.5.2"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "katex": "^0.17.0"
  }
}
